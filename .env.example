# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stellar

# Supabase (for file storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication (better-auth)
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://127.0.0.1:3000

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# App Url
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# GitLab OAuth (https://gitlab.com/-/user_settings/applications, scope: read_user)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (https://resend.com/api-keys)
# Required in production for email verification and password reset. Without
# both of these, those mails are logged to the console in development and the
# auth flows that need them fail in production.
# EMAIL_FROM must be an address on a domain verified with Resend,
# e.g. "Stellar <noreply@your-domain.com>"
RESEND_API_KEY=
EMAIL_FROM=
